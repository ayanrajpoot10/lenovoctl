cmd_touchpad() {
    local action="$1"
    
    if [ "$action" = "-h" ] || [ "$action" = "--help" ] || [ "$action" = "help" ] || [ -z "$action" ]; then
        echo "Usage: lenovoctl touchpad <status|on|off>"
        echo "  status : Show current touchpad status"
        echo "  on     : Enable touchpad"
        echo "  off    : Disable touchpad"
        return
    fi

    if [ ! -f $VPC/touchpad ]; then
        echo "Touchpad control not supported on this device."
        return 1
    fi

    if [ "$action" = "status" ]; then
        local status=$(cat $VPC/touchpad)
        if [ "$status" = "1" ]; then
            echo "Touchpad is ON"
        else
            echo "Touchpad is OFF"
        fi
        return
    fi

    if [ "$action" = "on" ]; then
        run_as_root "echo '1' > $VPC/touchpad"
        echo "Touchpad enabled."
    elif [ "$action" = "off" ]; then
        run_as_root "echo '0' > $VPC/touchpad"
        echo "Touchpad disabled."
    else
        echo "Invalid action."
        exit 1
    fi
}

if [ $# -eq 0 ]; then
    show_help
    exit 1
fi

command="$1"
shift

case "$command" in
    fan)
        cmd_fan "$1"
        ;;
    conservation)
        cmd_conservation "$1"
        ;;
    usb)
        cmd_usb "$1"
        ;;
    fnlock)
        cmd_fnlock "$1"
        ;;
    camera)
        cmd_camera "$1"
        ;;
    touchpad)
        cmd_touchpad "$1"
        ;;
    -h|--help|help)
        show_help
        ;;
    *)
        echo "Error: Unknown command '$command'"
        show_help
        exit 1
        ;;
esac
